echo "🔍 Running pre-commit checks..."

bun run lint || {
  echo "❌ Linting failed. Please fix the issues before committing."
  exit 1
}

bun x biome format --staged --files-ignore-unknown=true --no-errors-on-unmatched || {
	echo "❌ Formatting check failed. Please run 'bun run format' and try again."
	exit 1
}

echo "✅ Pre-commit checks passed!"
