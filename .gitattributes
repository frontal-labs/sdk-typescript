# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source files
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Configuration files
*.toml text eol=lf
*.config.* text eol=lf
.*rc text eol=lf
.*ignore text eol=lf

# Documentation
*.txt text eol=lf
*.rst text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary

# Generated files
*.tgz binary
*.tar binary
*.zip binary

# Lock files (should be preserved as-is)
bun.lockb binary
bun.lock text eol=lf
package-lock.json text
yarn.lock text
pnpm-lock.yaml text
