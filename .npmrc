# Frontal SDK npm registry configuration
# Default registry for all packages
registry=https://registry.npmjs.org/

# Authentication scope for @frontal packages
@frontal:registry=https://registry.npmjs.org/

# Always authenticate when publishing
always-auth=true

# Save exact versions for reproducibility
save-exact=true

# Use npm's built-in cache for performance
cache=/tmp/npm-cache

# Development/staging registry support (optional)
# Uncomment and set environment variable for alternative registries
# registry=${DEV_REGISTRY:-https://registry.npmjs.org/}
# @frontal:registry=${DEV_REGISTRY:-https://registry.npmjs.org/}
