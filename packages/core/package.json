{
  "name": "@frontal-labs/core",
  "version": "1.0.1",
  "description": "Frontal platform — shared client, schemas, and utilities",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "frontal": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/sdk-typescript.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/frontal-labs/sdk-typescript/issues",
  "homepage": "https://github.com/frontal-labs/sdk-typescript/tree/master/packages/core",
  "license": "MIT",
  "author": "Frontal Labs",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome lint src/ tests/",
    "clean": "rm -rf dist",
    "docs": "typedoc --entryPoints src/index.ts --out docs/v2 --entryPoints src/packages/* --excludePrivate --excludeProtected",
    "docs:json": "typedoc --json docs/v2/spec.json --entryPoints src/index.ts --entryPoints src/packages/* --excludePrivate --excludeExternals --excludeProtected"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.10",
    "tslib": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "tsup": "^8.0.0",
    "vitest": "^4.1.8",
    "@types/node": "^25.9.1"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "engines": {
    "bun": ">=1.3.8",
    "node": ">=18.0.0"
  }
}
