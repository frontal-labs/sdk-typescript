{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"outDir": "dist",
    "rootDir": "src",
	},
	"include": ["src"],
	"exclude": ["node_modules/**/*.ts"]
}
