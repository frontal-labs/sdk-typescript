{
  "name": "@frontal-labs/react",
  "version": "0.3.0",
  "description": "React hooks for the Frontal SDK: chat over ai.streamText, agent run streams, workflow approvals.",
  "keywords": [
    "react",
    "hooks",
    "frontal",
    "frontal-labs",
    "ai",
    "chat",
    "agents"
  ],
  "homepage": "https://github.com/frontal-labs/sdk-typescript/tree/master/packages/react",
  "bugs": "https://github.com/frontal-labs/sdk-typescript/issues",
  "license": "Apache-2.0",
  "author": "Frontal Labs",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/sdk-typescript.git",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && bun ../../scripts/fix-dts-extensions.ts dist",
    "build:watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint src/ tests/",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "bun": ">=1.3.8",
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@frontal-labs/agents": "^2.0.1",
    "@frontal-labs/ai": "^0.4.0",
    "@frontal-labs/core": "^1.2.0",
    "@frontal-labs/workflows": "^1.0.2",
    "tslib": "^2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
