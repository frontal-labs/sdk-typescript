# Frontal SDK Environment Variables
# Copy this file to .env and fill in your actual values

# Runtime environment
# Options: development, test, production
# Default: development
FRONTAL_ENV=development

# Frontal API key (required)
# Must start with "frt_"
FRONTAL_API_KEY=

# Frontal API base URL (optional)
# Default: https://api.frontal.dev/v1
FRONTAL_API_URL=

# Enable debug logging (optional)
# Values: true, false
# Default: false
FRONTAL_DEBUG=false
