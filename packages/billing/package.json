{
  "name": "@frontal-labs/billing",
  "version": "1.0.4",
  "description": "Frontal Billing SDK — plans, subscriptions, invoices, usage metering, and payment methods",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/sdk-typescript.git",
    "directory": "packages/billing"
  },
  "bugs": "https://github.com/frontal-labs/sdk-typescript/issues",
  "homepage": "https://github.com/frontal-labs/sdk-typescript/tree/master/packages/billing",
  "license": "Apache-2.0",
  "author": "Frontal Labs",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && bun ../../scripts/fix-dts-extensions.ts dist",
    "build:watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint src/ tests/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@frontal-labs/core": "^1.1.2",
    "tslib": "^2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.3.8",
    "node": ">=18.0.0"
  }
}
