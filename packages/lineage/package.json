{
  "name": "@frontal-labs/lineage",
  "version": "0.0.2",
  "description": "Frontal Lineage SDK \u2014 data lineage graphs, dependency tracing, and impact analysis",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/sdk-typescript.git",
    "directory": "packages/lineage"
  },
  "bugs": "https://github.com/frontal-labs/sdk-typescript/issues",
  "homepage": "https://github.com/frontal-labs/sdk-typescript/tree/master/packages/lineage",
  "license": "MIT",
  "author": "Frontal Labs",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome lint src/ tests/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@frontal-labs/core": "workspace:*",
    "zod": "^4.3.6",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@frontal-labs/testing": "workspace:*",
    "@types/bun": "^1.3.8",
    "@types/node": "^25.2.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "bun": ">=1.3.8",
    "node": ">=18.0.0"
  }
}
