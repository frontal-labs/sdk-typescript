{
  "name": "@frontal/testing",
  "version": "1.0.0",
  "description": "Frontal testing utilities and helpers",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-cloud/sdk-ts.git",
    "directory": "packages/testing"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome lint src/ tests/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@frontal/core": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/node": "^25.2.1",
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "vitest": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.8",
    "node": ">=18.0.0"
  }
}
