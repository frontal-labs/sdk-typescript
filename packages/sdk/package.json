{
  "name": "@frontal-labs/sdk",
  "version": "0.0.3",
  "description": "Unified SDK client for all Frontal services.",
  "keywords": [
    "javascript",
    "typescript",
    "sdk",
    "frontal",
    "frontal-labs"
  ],
  "homepage": "https://github.com/frontal-labs/sdk-typescript/tree/master/packages/sdk",
  "bugs": "https://github.com/frontal-labs/sdk-typescript/issues",
  "license": "MIT",
  "author": "Frontal Labs",
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "frontal-sdk": "./dist/index.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/sdk-typescript.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome lint src/ tests/",
    "clean": "rm -rf dist",
    "docs": "typedoc --entryPoints src/index.ts --out docs/v2 --excludePrivate --excludeProtected",
    "docs:json": "typedoc --json docs/v2/spec.json --entryPoints src/index.ts --excludePrivate --excludeExternals --excludeProtected"
  },
  "jsdelivr": "dist/umd/frontal-labs.js",
  "unpkg": "dist/umd/frontal-labs.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "bun": ">=1.3.8",
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@frontal-labs/agents": "workspace:*",
    "@frontal-labs/ai": "workspace:*",
    "@frontal-labs/audit": "workspace:*",
    "@frontal-labs/auth": "workspace:*",
    "@frontal-labs/billing": "workspace:*",
    "@frontal-labs/blob": "workspace:*",
    "@frontal-labs/connectors": "workspace:*",
    "@frontal-labs/core": "workspace:*",
    "@frontal-labs/data": "workspace:*",
    "@frontal-labs/datasets": "workspace:*",
    "@frontal-labs/events": "workspace:*",
    "@frontal-labs/workers": "workspace:*",
    "@frontal-labs/governance": "workspace:*",
    "@frontal-labs/graph": "workspace:*",
    "@frontal-labs/integrations": "workspace:*",
    "@frontal-labs/lineage": "workspace:*",
    "@frontal-labs/observability": "workspace:*",
    "@frontal-labs/ontology": "workspace:*",
    "@frontal-labs/pipelines": "workspace:*",
    "@frontal-labs/sandbox": "workspace:*",
    "@frontal-labs/schedules": "workspace:*",
    "@frontal-labs/webhooks": "workspace:*",
    "@frontal-labs/workflows": "workspace:*",
    "tslib": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@frontal-labs/testing": "workspace:*",
    "@types/bun": "^1.3.8",
    "@types/node": "^25.2.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
