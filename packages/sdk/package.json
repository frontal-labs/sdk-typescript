{
  "name": "@frontal-labs/sdk",
  "version": "1.0.4",
  "description": "Unified Frontal SDK client",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/sdk-typescript.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/frontal-labs/sdk-typescript/issues",
  "homepage": "https://github.com/frontal-labs/sdk-typescript/tree/master/packages/sdk",
  "license": "Apache-2.0",
  "author": "Frontal Labs",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome lint src/ tests/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@frontal-labs/agents": "^1.0.4",
    "@frontal-labs/ai": "^0.1.3",
    "@frontal-labs/audit": "^0.0.7",
    "@frontal-labs/auth": "^1.0.3",
    "@frontal-labs/billing": "^1.0.3",
    "@frontal-labs/blob": "^1.0.3",
    "@frontal-labs/connectors": "^0.0.6",
    "@frontal-labs/core": "^1.0.4",
    "@frontal-labs/data": "^0.1.3",
    "@frontal-labs/functions": "^0.0.1",
    "@frontal-labs/governance": "^0.0.6",
    "@frontal-labs/lineage": "^0.0.6",
    "@frontal-labs/observability": "^0.1.4",
    "@frontal-labs/ontology": "^1.0.3",
    "@frontal-labs/pipelines": "^0.0.5",
    "@frontal-labs/schedules": "^1.0.3",
    "@frontal-labs/webhooks": "^0.0.6",
    "@frontal-labs/workflows": "^0.1.3",
    "tslib": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/node": "^26.5.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "bun": ">=1.3.8",
    "node": ">=18.0.0"
  }
}
