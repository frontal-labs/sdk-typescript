{
  "name": "@frontal-labs/workflows",
  "version": "0.1.2",
  "description": "Frontal Workflows SDK — workflow orchestration with approvals and steps",
  "keywords": [
    "javascript",
    "typescript",
    "workflows",
    "orchestration",
    "approvals",
    "business-processes",
    "automation",
    "cloud",
    "frontal"
  ],
  "homepage": "https://github.com/frontal-labs/sdk-typescript/tree/master/packages/workflows",
  "bugs": "https://github.com/frontal-labs/sdk-typescript/issues",
  "license": "MIT",
  "author": "Frontal Labs",
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "frontal-workflows": "./dist/index.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/sdk-typescript.git",
    "directory": "packages/workflows"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:watch": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome lint src/ tests/",
    "clean": "rm -rf dist",
    "docs": "typedoc --entryPoints src/index.ts --out docs/v2 --entryPoints src/packages/* --excludePrivate --excludeProtected",
    "docs:json": "typedoc --json docs/v2/spec.json --entryPoints src/index.ts --entryPoints src/packages/* --excludePrivate --excludeExternals --excludeProtected"
  },
  "jsdelivr": "dist/umd/workflows.js",
  "unpkg": "dist/umd/workflows.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "bun": ">=1.3.8",
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@frontal-labs/core": "^1.0.3",
    "tslib": "^2.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/node": "^25.2.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
