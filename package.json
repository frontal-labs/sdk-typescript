{
  "name": "@frontal-labs/root",
  "version": "0.0.0",
  "private": true,
  "description": "Frontal JavaScript/Typescript SDK Monorepo",
  "keywords": [
    "javascript",
    "typescript",
    "sdk",
    "monorepo",
    "frontal",
    "frontal-labs",
    "frontal-labs"
  ],
  "homepage": "https://github.com/frontal-labs/sdk-typescript",
  "bugs": "https://github.com/frontal-labs/sdk-typescript/issues",
  "license": "MIT",
  "author": "Frontal Labs",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/sdk-typescript.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "biome format --write packages/ biome.jsonc package.json",
    "format:check": "biome format packages/ biome.jsonc package.json",
    "test": "vitest run",
    "test:live": "bun scripts/live-backend-compat.ts",
    "contract:sync": "bun scripts/contract-sync.ts",
    "contract:endpoints": "bun scripts/endpoint-contract.ts",
    "contract:endpoints:update": "bun scripts/endpoint-contract.ts --update",
    "contract:report": "bun scripts/endpoint-contract.ts --report-only",
    "contract:matrix": "bun scripts/contract-migration-matrix.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && bun run clean:workspaces",
    "clean:workspaces": "bun scripts/clean.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "husky",
    "setup": "bun scripts/setup.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@changesets/cli": "^2.27.12",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^2.1.8",
    "husky": "^9.1.7",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.8"
  },
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "frontal-sdk": "scripts/index.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "^14.0.3"
  }
}
