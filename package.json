{
  "name": "sdk-typescript",
  "version": "0.0.0",
  "private": true,
  "description": "Frontal JavaScript/Typescript SDK Monorepo",
  "keywords": [
    "javascript",
    "typescript",
    "sdk",
    "monorepo",
    "frontal",
    "frontal-labs"
  ],
  "homepage": "https://github.com/frontal-labs/sdk-typescript",
  "bugs": "https://github.com/frontal-labs/sdk-typescript/issues",
  "license": "Apache-2.0",
  "author": "Frontal Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/frontal-labs/sdk-typescript.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "biome format --write packages/ biome.jsonc package.json",
    "format:check": "biome format packages/ biome.jsonc package.json",
    "test": "vitest run",
    "test:live": "bun scripts/live-backend-compat.ts",
    "runtime:smoke": "node scripts/package-runtime-smoke.mjs",
    "contract:sync": "bun scripts/contract-sync.ts",
    "contract:endpoints": "bun scripts/endpoint-contract.ts",
    "contract:endpoints:update": "bun scripts/endpoint-contract.ts --update",
    "contract:report": "bun scripts/endpoint-contract.ts --report-only",
    "contract:matrix": "bun scripts/contract-migration-matrix.ts",
    "contract:decisions": "bun scripts/generate-decisions-openapi.ts",
    "contract:decisions:check": "bun scripts/generate-decisions-openapi.ts --check",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "turbo run type-check && bun run type-check:tests",
    "type-check:tests": "tsc -p tsconfig.tests.json",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version && bun scripts/sync-versions.ts",
    "release": "changeset publish",
    "publish:github": "bun run scripts/publish-github.ts",
    "prepare": "lefthook install",
    "docs:manifest": "bun scripts/generate-docs-manifest.ts",
    "docs:manifest:check": "bun scripts/generate-docs-manifest.ts --check",
    "docs:examples": "bun scripts/extract-examples.ts",
    "test:examples": "vitest run tests/examples"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@changesets/cli": "3.0.3",
    "@clack/prompts": "^1.1.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/bun": "^1.3.10",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "commander": "^15.0.0",
    "lefthook": "^2.1.12",
    "lint-staged": "17.6.0",
    "turbo": "2.11.10",
    "typescript": "^6.0.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "fast-uri": "^4.2.3",
    "picomatch": "^4.0.4",
    "launch-editor": "^2.14.2",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.32",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.2.0"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.8"
  },
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "frontal-sdk": "scripts/index.ts"
  }
}
